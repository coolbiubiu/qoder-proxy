# Copy this file to .env for local use only.
# Do not commit .env or share its contents.

PORT=3000

# Require callers to present this key as "Authorization: Bearer <key>" or
# "x-api-key: <key>". Applies to /v1/* and /usage/*.
# Leave empty to require no key — then any process on this machine can use the
# proxy and spend your Qoder quota. Setting it is recommended.
PROXY_API_KEY=

# CLI backend: "cn" (qoderclicn) or "global" (qodercli)
CLI_BACKEND=cn

# CN backend token (from qoder.com.cn)
QODERCN_PERSONAL_ACCESS_TOKEN=your-cn-token
# Global backend token (from qoder.com, or run `qodercli login`)
QODER_PAT=your-global-token

# Override CLI command auto-detection (optional)
# CLI_COMMAND=

QODERCN_REASONING_EFFORT=
QODERCN_CONTEXT_WINDOW=
QODERCN_MAX_OUTPUT_TOKENS=
QODERCN_TIMEOUT_MS=120000

# ─── Concurrency control ─────────────────────────────────────────────────
# Each request spawns a CLI child process. Cap how many run at once so
# concurrent requests cannot saturate this machine; extra requests wait
# in a FIFO queue. Leave empty for no limit.
# MAX_CONCURRENT_CLI=2
# Max milliseconds a request may wait in the queue before failing with 503.
# 0 or empty means wait indefinitely.
# CLI_QUEUE_TIMEOUT_MS=30000

# Clients may override the per-request CLI timeout with the request header
# "x-qoder-timeout: <seconds>" (capped at 600s), which wins over
# QODERCN_TIMEOUT_MS for that single request.

# ─── Request history ────────────────────────────────────────────────────
# How many recent request outcomes to keep for the web console's "Recent
# Requests" panel (max 1000). Rows are stored in the SQLite database below,
# so the history survives restarts.
# HISTORY_LIMIT=100

# Where persisted usage stats are written. Defaults to usage.json in the
# project root; the test suite points this at a temp file so `npm test`
# never touches your real statistics.
# QODER_PROXY_USAGE_FILE=

# SQLite database file holding the persisted request history. Defaults to
# proxy.db in the project root; tests redirect it to a temp file as well.
# QODER_PROXY_DB_FILE=

# ─── Logging ──────────────────────────────────────────────────────────────
# Verbosity: debug, info (default), warn, error
# LOG_LEVEL=info

# ─── Network access control ──────────────────────────────────────────────────
# Browser requests are accepted only from loopback origins, and only for
# loopback Host headers. Both defaults are secure; override only if you know
# why you need to.
#
# Extra browser origins allowed to call the proxy (comma-separated), e.g. a
# local web app on another port: ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=
# Extra Host header values to accept (comma-separated). Only needed if you
# deliberately front the proxy with another hostname. Leaving this empty is
# what blocks DNS-rebinding attacks from web pages.
ALLOWED_HOSTS=

# ─── Server-side tool execution (default: off) ───────────────────────────────
# Off: tool_calls are returned to the client (required for agent clients
# like OpenCode / Trae / Cline that execute tools in their own workspace).
# Set to 1 only if your client cannot execute tools itself.
#
# When enabled, the model's tool calls run on THIS machine, and the model is
# steered by whatever prompt the client sent. Treat it as experimental.
SERVER_TOOL_EXECUTION=

# Directory that Read/Write/Edit/Glob/Grep/Bash are confined to.
# Defaults to the proxy's working directory. Paths outside it are refused.
SERVER_TOOL_WORKSPACE=

# The Bash tool additionally requires this flag AND a non-empty allowlist.
# Commands run without a shell, so pipes, chaining, redirection and
# substitution are refused. Note: on Windows this cannot run .cmd/.bat
# shims (npm, yarn), only real executables (node, git, python).
SERVER_TOOL_ALLOW_BASH=
# Bare executable names permitted for the Bash tool, comma-separated.
# Empty means no command may run. Example: git,node,python
SERVER_TOOL_BASH_ALLOWLIST=
