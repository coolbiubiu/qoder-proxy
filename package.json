{
  "name": "qoder-proxy",
  "version": "1.6.0",
  "description": "Local OpenAI / Anthropic compatible proxy for Qoder CLI and Qoder CN CLI",
  "main": "clean/server.js",
  "files": [
    "clean/",
    "public/",
    "scripts/",
    "test/",
    "opencode.json",
    "start-proxy.cmd",
    "start-ui.cmd",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "start": "node clean/server.js",
    "dev": "node clean/server.js",
    "build": "esbuild clean/server.js --bundle --platform=node --target=node18 --outfile=dist/server.js",
    "start:prod": "node dist/server.js",
    "build:start": "npm run build && npm run start:prod",
    "test": "node --test --require ./test/setup.js",
    "smoke": "node scripts/smoke.js",
    "smoke:full": "node scripts/smoke.js --full"
  },
  "keywords": [
    "qoder",
    "qoder-cn",
    "qodercn",
    "openai-compatible",
    "anthropic-compatible",
    "local-adapter",
    "compatibility",
    "protocol-research",
    "streaming",
    "tool-calls"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/avaritiachaos/qoder-proxy"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
